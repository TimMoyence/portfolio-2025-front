{
  "path": ["src", "e2e"],
  "format": ["typescript"],
  "minLines": 5,
  "minTokens": 30,
  "maxLines": 100000,
  "maxSize": "10mb",
  "mode": "weak",
  "gitignore": true,
  "absolute": false,
  "pattern": "{src/**/*.spec.ts,src/testing/**/*.ts,e2e/**/*.ts}",
  "ignore": ["**/node_modules/**", "**/dist/**", "**/coverage/**"],
  "reporters": ["console", "threshold"],
  "threshold": 0
}
