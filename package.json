{
  "name": "portfolio-app",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "prepare": "husky",
    "start": "ng serve",
    "build": "npm run seo:lastmod && CI=true ng build",
    "seo:lastmod": "node scripts/update-seo-lastmod.mjs",
    "seo:lastmod:check": "node scripts/update-seo-lastmod.mjs --check",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "test:ci": "ng test --watch=false --browsers=ChromeHeadlessNoSandbox",
    "test:cov": "ng test --watch=false --browsers=ChromeHeadlessNoSandbox --code-coverage",
    "lint": "eslint . --ext .ts,.html,.js,.mjs --max-warnings=0",
    "lint:fix": "eslint . --ext .ts,.html,.js,.mjs --fix",
    "format:check": "prettier --check \"src/**/*.{ts,html,scss,json}\" \"*.{json,js,cjs,md,yml,yaml}\" \".github/**/*.{md,yml,yaml}\" \"docs/**/*.md\"",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "guard:comments": "node scripts/guard-no-comments.cli.mjs --root .",
    "guard:comments:count": "node scripts/guard-no-comments.cli.mjs --root . --count",
    "guard:comments:tighten": "node scripts/guard-no-comments.cli.mjs --root . --tighten",
    "test:guards": "node --test \"scripts/**/*.test.mjs\"",
    "guard:cours-runtime": "node scripts/guard-cours-runtime.cli.mjs",
    "guard:cours-bundle": "node scripts/lints-cours/regles/bundle.mjs dist",
    "pre-push:check": "npm run lint && npm run format:check && npm run typecheck && npm run quality:dup && npm run quality:dup:tests && npm run quality:knip && npm run test:guards && npm run guard:cours-runtime && npm run guard:comments && npm run test:ci && npm run build && npm run guard:cours-bundle && npm run test:e2e:cours",
    "ci:check": "npm run lint && npm run format:check && npm run typecheck && npm run quality:dup && npm run quality:dup:tests && npm run quality:knip && npm run test:guards && npm run guard:cours-runtime && npm run guard:comments && npm run test:ci && npm run build && npm run guard:cours-bundle && npm run test:e2e:portail",
    "serve:ssr:portfolio-app": "node dist/portfolio-app/server/fr/server.mjs",
    "serve:ssr:portfolio-app:en": "PORT=4001 node dist/portfolio-app/server/en/server.mjs",
    "extract-i18n": "ng extract-i18n --output-path src/locale --format xlf",
    "formation:validate": "node scripts/validate-formation.mjs",
    "test:e2e": "npx playwright test --project=chromium",
    "test:e2e:cours": "npx playwright test --project=chromium e2e/cours-b2-server.spec.ts e2e/cours-pupitre.spec.ts e2e/cours-reprise.spec.ts e2e/cours-runtime.spec.ts e2e/cours-session.spec.ts e2e/slide-engine.spec.ts",
    "test:e2e:portail": "SSR_BASE_URL=http://localhost:4000 SSR_EN_BASE_URL=http://localhost:4001 npx playwright test --project=chromium",
    "test:e2e:ui": "npx playwright test --project=chromium --ui",
    "build:banc": "ng build --configuration banc",
    "test:banc": "node scripts/banc/jouer.mjs",
    "banc:nettoyer": "docker compose -p portfolio2025-banc -f scripts/banc/banc.compose.yaml down -v --remove-orphans",
    "lighthouse": "lhci autorun",
    "lighthouse:collect": "lhci collect",
    "lighthouse:assert": "lhci assert",
    "quality:dup": "jscpd src scripts",
    "quality:dup:tests": "jscpd --config .jscpd.tests.json",
    "quality:dup:report": "jscpd src scripts --reporters html --output reports/jscpd",
    "quality:knip": "knip"
  },
  "lint-staged": {
    "*.{ts,js,mjs,html}": [
      "eslint --fix --max-warnings=0 --no-warn-ignored"
    ],
    "*.{ts,js,mjs,html,scss,css,json,md,cjs,yml,yaml}": [
      "prettier --write"
    ]
  },
  "private": true,
  "guard-no-comments": {
    "maxOffenses": 0
  },
  "dependencies": {
    "@angular/animations": "^19.2.25",
    "@angular/common": "^19.2.25",
    "@angular/compiler": "^19.2.25",
    "@angular/core": "^19.2.25",
    "@angular/forms": "^19.2.25",
    "@angular/platform-browser": "^19.2.25",
    "@angular/platform-browser-dynamic": "^19.2.25",
    "@angular/platform-server": "^19.2.25",
    "@angular/router": "^19.2.25",
    "@angular/ssr": "^19.2.27",
    "@fontsource/geist-mono": "^5.2.8",
    "@fontsource/hanken-grotesk": "^5.2.8",
    "@fontsource/instrument-serif": "^5.2.8",
    "express": "^4.18.2",
    "qr-code-styling": "^1.9.2",
    "rxjs": "~7.8.0",
    "swiper": "^12.1.3",
    "tslib": "^2.3.0",
    "zone.js": "~0.15.0"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^19.2.27",
    "@angular/cli": "^19.2.27",
    "@angular/compiler-cli": "^19.2.25",
    "@angular/localize": "^19.2.25",
    "@commitlint/cli": "^20.5.0",
    "@commitlint/config-conventional": "^20.5.0",
    "@eslint/js": "^9.39.4",
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "^1.59.1",
    "@types/express": "^4.17.17",
    "@types/jasmine": "~5.1.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^18.18.0",
    "angular-eslint": "^19.8.1",
    "autoprefixer": "^10.4.14",
    "eslint": "^9.39.2",
    "eslint-plugin-sonarjs": "^4.2.0",
    "fast-check": "^4.10.2",
    "globals": "^16.5.0",
    "husky": "^9.1.7",
    "jasmine-core": "~5.6.0",
    "jscpd": "^5.0.14",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "knip": "^6.32.0",
    "lint-staged": "^16.4.0",
    "postcss": "^8.4.21",
    "prettier": "^3.9.6",
    "tailwindcss": "^3.3.0",
    "typescript": "~5.7.2",
    "typescript-eslint": "^8.57.1"
  },
  "overrides": {
    "qs": "6.16.0"
  }
}
