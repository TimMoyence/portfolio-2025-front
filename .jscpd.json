{
  "path": ["src", "scripts"],
  "minLines": 5,
  "minTokens": 30,
  "maxLines": 100000,
  "maxSize": "10mb",
  "mode": "weak",
  "format": ["typescript", "markup", "scss", "css", "javascript"],
  "threshold": 0,
  "reporters": ["console", "threshold"],
  "gitignore": true,
  "absolute": false,
  "ignore": [
    "**/node_modules/**",
    "**/dist/**",
    "**/.angular/**",
    "**/coverage/**",
    "**/playwright-report/**",
    "**/test-results/**",
    "src/locale/**",
    "src/assets/**",
    "public/**",
    "**/*.spec.ts",
    "src/testing/**",
    "e2e/**"
  ]
}
